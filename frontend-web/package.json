  "dependencies": {
    "jose": "6.2.12",
    "next": "16.4.1",
    "nodemailer": "10.0.12",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
