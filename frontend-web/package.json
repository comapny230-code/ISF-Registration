{
  "name": "isf-registration",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test-db:start": "node scripts/test-db.mjs start",
    "test-db:stop": "node scripts/test-db.mjs stop",
    "preflight": "node --experimental-transform-types --no-warnings --import ./scripts/node-ts-hooks.mjs scripts/preflight.mts",
    "mail:check": "node --experimental-transform-types --no-warnings --import ./scripts/node-ts-hooks.mjs scripts/mail-check.mts",
    "db:setup": "node scripts/db-setup.mjs",
    "db:verify": "node scripts/db-setup.mjs --verify-only",
    "db:create-admin": "node --experimental-transform-types --no-warnings --import ./scripts/node-ts-hooks.mjs scripts/create-admin.mts"
  },
  "dependencies": {
    "jose": "6.2.12",
    "next": "16.4.1",
    "nodemailer": "10.0.12",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
