# ==============================================================================
# ISF STARTUP JATHARA 2026 - ENVIRONMENT VARIABLES (placeholders only)
# Never commit real values. See docs/STALL_BOOKING_FINAL_SPEC.md §8.4.
# ==============================================================================

# local | test | staging | production
APP_ENV=local

# Runtime database (Supabase transaction pooler in staging/production, port 6543).
# Not used when APP_ENV=test (tests use TEST_DATABASE_URL only).
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
# PEM of the database CA; required in staging and production (TLS is verified).
DATABASE_CA_CERT=
# Comma-separated identifiers of the production database (e.g. its project ref).
# Required outside production; the app refuses to connect to any match.
PRODUCTION_DB_DENYLIST=<production-project-ref>

# Tests only (see frontend-web/scripts/test-db.mjs)
# TEST_DATABASE_URL=postgresql://isf_test:isf_test@localhost:54329/isf_test

# Mail: smtp (default) or log (local/test only)
MAIL_TRANSPORT=smtp
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
NOTIFY_EMAIL_FROM="ISF · Startup Jathara 2026" <no-reply@example.org>
NOTIFY_REPLY_TO=
# Required outside production: exact addresses or @domain entries, comma-separated.
MAIL_RECIPIENT_ALLOWLIST=@example.test

# Authentication (required). Origins are used for CSRF checks; extras are for
# preview deployments only and must be unset in production.
APP_ORIGIN=http://localhost:3000
APP_EXTRA_ORIGINS=
# Independent random values of at least 32 characters (e.g. `openssl rand -base64 48`).
OTP_PEPPER=<random-32+-characters>
RATE_LIMIT_HASH_KEY=<different-random-32+-characters>

# Shows the /book-your-stall page and header link ("true" to enable). Booking itself
# also stays closed until booking.settings is opened by an operator.
FEATURE_BOOKING_UI=false

# Registration kill switch: registration (form, email codes, submissions) is open only when
# this is exactly "true". Unset or anything else pauses it on the next request; no redeploy
# of code is needed, only a change of this setting (and, on Vercel, a redeploy to apply it).
REGISTRATION_OPEN=false

# Stall booking: hold-token signing keys "kid:secret[,kid:secret]". The first key
# signs; keep the previous key listed while rotating. Secrets >= 32 characters.
HOLD_TOKEN_KEYS=k1:<random-32+-characters>

# ImageKit (required in staging/production; optional in local; must be unset in test)
IMAGEKIT_PRIVATE_KEY=<imagekit-private-key>
IMAGEKIT_FOLDER=/isf_registrations

# Optional Cloudflare Turnstile human check on registration (both or neither).
# Leave both empty to keep it off. The secret key is a server secret: never commit it.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Local/test only: minimum seconds to fill the registration form (always 20 in staging/production).
# REGISTRATION_MIN_FILL_SECONDS=0
