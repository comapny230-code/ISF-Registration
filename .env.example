# ---- API (apps/api) ----
DATABASE_URL=postgres://postgres@127.0.0.1:54329/jathara
PORT=4000
# dev = locally signed tokens (never in staging/production); supabase = verify Supabase Auth JWTs via JWKS
AUTH_MODE=dev
DEV_AUTH_SECRET=change-me-dev-only-secret-at-least-32-chars
SUPABASE_URL=
# Server-side only (never NEXT_PUBLIC_*): reads authoritative email/phone confirmation from Supabase Auth
SUPABASE_SERVICE_ROLE_KEY=
# Require aal2 (MFA) tokens for admin, management and customer-support roles.
# Defaults to true when NODE_ENV=production and may not be false there. Leave unset locally (off) or set true to test.
REQUIRE_STAFF_MFA=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info
# Activation codes for imported participants are single-use; validity period is provisional (requirements do not specify it)
ACTIVATION_TTL_HOURS=72
# Production launch gate: the API refuses to start in production until docs/LAUNCH_CHECKLIST.md is signed off.
# Never set this in development, and set it in production only after sign-off.
LAUNCH_APPROVED=

# ---- Background workers, AI ranking and messages (Phase 5; docs/DECISIONS.md TBD-13, -14, -35) ----
# Ranking runs and the email/SMS outbox run inside the API unless RUN_WORKERS=false (then run `start:worker`).
RUN_WORKERS=true
PUBLIC_WEB_URL=http://localhost:3000
# stub = development stub, NOT an AI (refused in production). vertex = Google Vertex AI.
RANKING_PROVIDER=stub
RANKING_VERTEX_PROJECT=
RANKING_VERTEX_LOCATION=asia-south1
RANKING_VERTEX_MODEL=
# A service account used only for ranking (FR-RNK-12); the runtime identity impersonates it.
RANKING_VERTEX_SERVICE_ACCOUNT=
# none = messages stay queued (activation codes are then handed over manually); log = development only; smtp / msg91 = live.
NOTIFY_EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_TEMPLATE_RESULT=
MSG91_TEMPLATE_CORRECTION=
MSG91_TEMPLATE_ACTIVATION=
MSG91_TEMPLATE_ASSIGNMENT=
# Phase 7: push notifications for notices (none | log (development only) | expo, TBD-52) and document storage
# (database = development only | supabase = private Supabase Storage bucket, TBD-51). EXPO_ACCESS_TOKEN is a server-side secret.
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=
STORAGE_PROVIDER=database
STORAGE_BUCKET=event-documents
FILE_LINK_SECRET=
# Phase 8: AI Help Desk in the app (TBD-35, TBD-54). Separate configuration and service account from ranking (FR-HD-20).
# stub = development stand-in, NOT an AI (refused in production); none = fallback answers only; vertex = Google Vertex AI.
# WhatsApp is not part of this API (owned by a separate integration workstream).
HELPDESK_PROVIDER=stub
HELPDESK_VERTEX_PROJECT=
HELPDESK_VERTEX_LOCATION=asia-south1
HELPDESK_VERTEX_MODEL=
HELPDESK_VERTEX_SERVICE_ACCOUNT=
# Questions per person per minute
HELPDESK_RATE_LIMIT=20
# Development only: pin the API clock, e.g. DEV_NOW=2026-11-06T10:00:00+05:30 to try ranking after the deadline.
DEV_NOW=

# ---- Web apps (apps/web, apps/console) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_MODE=dev
# Website sign-in channels (TBD-12, docs/DECISIONS.md): "email", "phone" or "email,phone" (unset = both).
# Staging/production: "email" until the DLT-registered SMS sender is live, then "email,phone".
NEXT_PUBLIC_SIGNIN_METHODS=email,phone
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Mobile app (apps/mobile; Expo inlines EXPO_PUBLIC_* at build time) ----
# Leave EXPO_PUBLIC_API_URL empty in development: the app uses the computer running Expo on port 4000.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_SIGNIN_METHODS=email,phone
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Email / SMTP Notifications (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=akshatrajpati@gmail.com
SMTP_PASS=sndyvqfgfaohmmnh
NOTIFY_EMAIL_FROM="ISF · Startup Jathara 2026" <akshatrajpati@gmail.com>
